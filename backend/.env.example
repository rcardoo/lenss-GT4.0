# Copie este arquivo para .env e preencha. O .env NÃO vai para o GitHub.
# No seu computador, só o JWT_SECRET é obrigatório. Online (Vercel), os valores
# vão nas "Environment Variables" do projeto, e não num arquivo.

# Porta da API no computador (a Vercel não usa)
PORTA=3000

# Segredo que assina os tokens de login. Use um texto longo e aleatório:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Senha das contas de exemplo do npm run seed (só no computador). Vazio = 123456.
SEED_SENHA=

# --- Online, na Vercel ---
# Banco no Turso (um SQLite na nuvem). Vazio = o arquivo banco.db do computador.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Fotos no Vercel Blob. A Vercel cria esta variável sozinha quando você conecta
# um Blob ao projeto. Vazio = as fotos vão para a pasta uploads do computador.
BLOB_READ_WRITE_TOKEN=

# --- Opcional: testes ---
# Outra pasta para o banco e as fotos (ex: uma cópia para testar). Vazio = a própria pasta backend.
DADOS_DIR=
